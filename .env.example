# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# PostgreSQL connection string used by Prisma in local development
DATABASE_URL=postgresql://ecommerve:ecommerve@localhost:55432/ecommerve?schema=public

# At least 32 characters; generate one with: openssl rand -hex 32
NUXT_SESSION_PASSWORD=
